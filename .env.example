# Twitch application credentials — create an app at https://dev.twitch.tv/console
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI — must match what you registered in the Twitch console
REDIRECT_URI=http://localhost:3000/callback

# Port for the local auth web server
PORT=3000

# Login name (username) of the primary channel the bot will join and listen to
# (the numeric user ID is resolved automatically at startup)
CHAT_CHANNEL=your_channel_here

# Optional debug/testing channel (login name). Debug-only commands (!fakevip, !testvip) are enabled here.
# DEBUG_CHANNEL=your_testing_channel

# Webhook secret — an arbitrary random string used to verify requests from Twitch (e.g. 40 random hex chars)
WEBHOOK_SECRET=your_webhook_secret_here

# Public URL Twitch will POST EventSub events to
WEBHOOK_CALLBACK_URL=https://your_domain_here/eventsub
